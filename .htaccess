# =====================================================================
# Clínica Dentária S. Dâmaso — configuração Apache (cPanel)
# Segurança, desempenho e cache. Ficheiro estático: não requer Node.
# =====================================================================

DirectoryIndex index.html
ErrorDocument 404 /404.html

# Impede a listagem de diretórios
Options -Indexes

# ---------------------------------------------------------------------
# 1. Forçar HTTPS
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pastas de trabalho: não devem sequer ser enviadas para o servidor, mas
  # se forem por engano ficam inacessíveis
  RewriteRule ^(_ferramentas|_originais)/ - [F,L]

  # Redireciona http:// para https:// (independente do domínio)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ATIVAR DEPOIS DE ESCOLHER O DOMÍNIO CANÓNICO (com ou sem www).
  # Descomente APENAS um dos blocos e substitua pelo domínio real.
  #
  # Forçar www:
  # RewriteCond %{HTTP_HOST} ^exemplo\.pt$ [NC]
  # RewriteRule ^(.*)$ https://www.exemplo.pt/$1 [R=301,L]
  #
  # Forçar sem www:
  # RewriteCond %{HTTP_HOST} ^www\.exemplo\.pt$ [NC]
  # RewriteRule ^(.*)$ https://exemplo.pt/$1 [R=301,L]

  # Remove o .html do URL (opcional): /contactos em vez de /contactos.html
  # RewriteCond %{REQUEST_FILENAME}.html -f
  # RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# ---------------------------------------------------------------------
# 2. Cabeçalhos de segurança
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  # Política de segurança de conteúdo.
  # O site não usa scripts, estilos nem tipos de letra externos.
  # A única exceção é o mapa do Google, carregado num iframe a pedido.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self'; frame-src https://www.google.com; upgrade-insecure-requests"

  # Impede o navegador de adivinhar o tipo de ficheiro
  Header always set X-Content-Type-Options "nosniff"

  # Não envia o URL completo para sites externos
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Bloqueia o enquadramento por outros sites (complementa frame-ancestors)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Desativa APIs do navegador que este site não utiliza
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), accelerometer=()"

  # Isola o contexto de navegação
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # HSTS — ATIVAR SÓ DEPOIS DE CONFIRMAR QUE O HTTPS FUNCIONA EM TODO O SITE.
  # Uma vez enviado, o navegador recusa ligações http durante max-age segundos.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Remove cabeçalhos que revelam a infraestrutura
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------
# 3. Tipos MIME (alguns servidores não os trazem configurados)
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif                   .avif
  AddType image/webp                   .webp
  AddType font/woff2                   .woff2
  AddType application/manifest+json    .webmanifest
  AddType text/javascript              .js
  AddType image/svg+xml                .svg
</IfModule>

# ---------------------------------------------------------------------
# 4. Compressão
# ---------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/xml text/plain
</IfModule>

# Imagens e tipos de letra já vêm comprimidos: não voltar a comprimir
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Request_URI \.(?:avif|webp|png|jpe?g|woff2)$ no-gzip dont-vary
</IfModule>

# ---------------------------------------------------------------------
# 5. Cache
#    Os ficheiros em /assets são versionados pelo nome (ex.: hero-1280.avif),
#    por isso podem ser guardados durante um ano. O HTML é sempre revalidado
#    para que qualquer alteração apareça de imediato.
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|png|jpe?g|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # CSS e JS não têm hash no nome: cache longa, mas sem "immutable",
  # para que um Ctrl+F5 do cliente chegue para ver alterações.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
# 6. Proteger ficheiros sensíveis
# ---------------------------------------------------------------------
<FilesMatch "^\.|(\.(bak|config|sql|ini|log|sh|inc|md|json|mjs)|~)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Exceção: o manifesto tem de continuar acessível
<Files "site.webmanifest">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</Files>
